    "點面板上的圖示會先回到這個 app，再跳到目標 app。iOS 只允許小工具開自己的 app。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapping an icon on the panel opens this app first, then the target app. iOS only lets widgets open their own app."
          }
        }
      }
    },
    "（無標題）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Untitled)"
          }
        }
